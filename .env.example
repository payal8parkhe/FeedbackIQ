# FeedbackIQ Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=feedbackiq-super-secret-key-change-in-production

# LLM Providers (OpenAI, Anthropic, or Fake/Ollama)
LLM_PROVIDER=fake                  # fake | openai | anthropic | ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Models configuration (Cheap model for enrichment, strong for Q&A and Judge)
ENRICH_MODEL=gpt-4o-mini
ANSWER_MODEL=gpt-4o
JUDGE_MODEL=gpt-4o
EMBED_MODEL=text-embedding-3-small

# Batching & Caching
BATCH_MAX_ITEMS=15
BATCH_MAX_TOKENS=6000
MAX_REVIEW_CHARS=2000
CACHE_TTL_DAYS=30
ENABLE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379/0

# Database
DATABASE_URL=sqlite+aiosqlite:///./feedbackiq.db
# For production PostgreSQL with pgvector:
# DATABASE_URL=postgresql+asyncpg://feedbackiq:feedbackiq_secret@localhost:5432/feedbackiq

# Retrieval & QA parameters
RRF_K=60
RETRIEVE_K=30
CONTEXT_K=8
MIN_CONFIDENCE=0.5
DAILY_BUDGET_USD=50.0

# Versions (included in cache key)
PROMPT_VERSION=v1
TAXONOMY_VERSION=v1
